# Public client values only. Never put a Supabase secret/service-role key in Expo.
# Local development must set these explicitly; there is no silent production fallback.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional local metadata. EAS project linking is already configured in app.json.
EXPO_PROJECT_ID=
EXPO_OWNER=
